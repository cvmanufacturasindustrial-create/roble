# Variables de entorno de ROBLE (en Render: servicio → Environment). Ninguna es obligatoria
# para arrancar; sin MP_ACCESS_TOKEN el botón de Mercado Pago no aparece y queda WhatsApp.

# Mercado Pago → Tus integraciones → tu aplicación → Credenciales de producción → Access Token
# (APP_USR-...). Para pruebas usa el de prueba (TEST-...).
MP_ACCESS_TOKEN=
# Mercado Pago → tu aplicación → Webhooks → "Clave secreta" (valida que el aviso viene de MP)
MP_WEBHOOK_SECRET=
# URL pública del sitio, con https (ej. https://tudominio.com). Si falta, se usa la del request.
SITIO_URL=
